{
    "cli": {
        "version": ">= 16.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "base": {
            "node": "22.16.0",
            "env": {
                "EXPO_PUBLIC_API_URL": "https://web-production-b2f8bff1.up.railway.app"
            }
        },
        "preview": {
            "extends": "base",
            "distribution": "internal",
            "android": { "buildType": "apk" },
            "ios": { "simulator": true }
        },
        "production": {
            "extends": "base",
            "autoIncrement": true,
            "android": { "buildType": "app-bundle" }
        }
    },
    "submit": {
        "production": {}
    }
}
